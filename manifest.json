{
  "manifest_version": 3,
  "name": "Blank Tab",
  "description": "A peaceful new tab that centers time, essentials, and clarity.",
  "version": "1.0.0",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "options_page" : "options.html",
  "permissions": [
    "bookmarks",
    "geolocation"
  ],
  "icons": {
    "16": "favicons/favicon-16x16.png",
    "32": "favicons/favicon-32x32.png",
    "48": "favicons/favicon-48x48.png",
    "128": "favicons/favicon-128x128.png"
  }
}
